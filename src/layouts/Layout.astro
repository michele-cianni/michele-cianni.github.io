---
import "../styles/global.css";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { languages, defaultLang } from "../i18n/ui";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: keyof typeof languages;
}

const {
  title = "Developer Portfolio",
  description = "A modern portfolio built with Astro to showcase projects, skills, and experience.",
  image = "/favicon.svg",
  lang = defaultLang,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageURL = new URL(image, Astro.url);

// Only "en" carries a path prefix today (prefixDefaultLocale: false); strip it
// to get the locale-agnostic path used to build alternate-language URLs.
const localePath = Astro.url.pathname.replace(/^\/en\/?/, "").replace(/^\//, "");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Portfolio Owner" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F6F1E7" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonicalURL} />
    {Object.keys(languages).map((locale) => (
      <link rel="alternate" hreflang={locale} href={getAbsoluteLocaleUrl(locale, localePath)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLang, localePath)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Newsreader:wght@400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Newsreader:wght@400;500;600&display=swap"
      />
    </noscript>
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <title>{title}</title>
  </head>
  <body class="paper-grain">
    <slot />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  :global(body) {
    margin: 0;
    width: 100%;
    min-height: 100vh;
  }
</style>
