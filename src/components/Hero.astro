---
import profile from '../data/profile.json';
const [firstName, lastName] = profile.name.split(' ');
---

<section id="hero" class="hero">
    <!-- Background layers -->
    <div class="hero-bg-grid" aria-hidden="true"></div>
    <div class="hero-bg-glow" aria-hidden="true"></div>

    <!-- Main content -->
    <div class="hero-content">
        <p class="hero-eyebrow">// michele.cianni<span class="cursor" aria-hidden="true">|</span></p>

        <h1 class="hero-name">
            <span class="name-line name-line-1">
                <span class="name-clip">{firstName}</span>
            </span>
            <span class="name-line name-line-2">
                <span class="name-clip">{lastName}</span>
            </span>
        </h1>

        <p class="hero-tagline">{profile.tagline}</p>

        <div class="hero-ctas">
            <a href="#projects" class="cta-primary">
                View Projects
                <span class="cta-arrow" aria-hidden="true">→</span>
            </a>
            <a href={profile.github} class="cta-secondary" target="_blank" rel="noopener noreferrer">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                </svg>
                GitHub
            </a>
            <a href={profile.linkedin} class="cta-secondary" target="_blank" rel="noopener noreferrer">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                LinkedIn
            </a>
        </div>
    </div>

    <!-- Scroll indicator -->
    <div class="scroll-hint" aria-hidden="true">
        <span class="scroll-label">scroll</span>
        <span class="scroll-line"></span>
    </div>
</section>

<style>
    /* ─── Layout ──────────────────────────────────────────────── */

    .hero {
        position: relative;
        min-height: 100svh;
        display: flex;
        align-items: center;
        overflow: hidden;
    }

    .hero-content {
        position: relative;
        z-index: 1;
        width: 100%;
        padding-top: 6rem;
        padding-bottom: 4rem;
        padding-inline: clamp(1.5rem, 8vw, 6rem);
        max-width: 90rem;
    }

    /* ─── Background Layers ───────────────────────────────────── */

    .hero-bg-grid {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(
            circle,
            color-mix(in srgb, #6C63FF 18%, transparent) 1px,
            transparent 1px
        );
        background-size: 32px 32px;
        mask-image: radial-gradient(ellipse 80% 80% at 20% 20%, black 30%, transparent 80%);
        opacity: 0.35;
        pointer-events: none;
    }

    .hero-bg-glow {
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse 60% 50% at 15% 85%,
            color-mix(in srgb, #6C63FF 12%, transparent),
            transparent 70%
        );
        pointer-events: none;
    }

    /* ─── Eyebrow ─────────────────────────────────────────────── */

    .hero-eyebrow {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--color-accent);
        opacity: 0;
        letter-spacing: 0.2em;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.1em;
        animation: fade-up 0.5s ease-out 0.15s both;
    }

    .cursor {
        color: var(--color-accent);
        animation: cursor-blink 1.1s step-end infinite;
        margin-left: 0.1em;
    }

    /* ─── Name ────────────────────────────────────────────────── */

    .hero-name {
        font-family: 'Bebas Neue', cursive;
        font-size: clamp(5rem, 16vw, 13rem);
        line-height: 0.88;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        color: var(--color-text-primary);
        display: block;
        margin: 0;
        margin-bottom: 1.5rem;
    }

    .name-line {
        display: block;
        overflow: hidden;
    }

    .name-clip {
        display: block;
        opacity: 0;
        animation-name: name-reveal;
        animation-duration: 0.7s;
        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
        animation-fill-mode: both;
    }

    .name-line-1 .name-clip {
        animation-delay: 0.2s;
    }

    .name-line-2 .name-clip {
        animation-delay: 0.37s;
    }

    /* ─── Tagline ─────────────────────────────────────────────── */

    .hero-tagline {
        font-family: var(--font-sans);
        font-size: clamp(1rem, 2.2vw, 1.25rem);
        color: var(--color-text-secondary);
        font-weight: 400;
        margin: 0 0 2.5rem;
        opacity: 0;
        animation: fade-up 0.5s ease-out 0.65s both;
    }

    /* ─── CTAs ────────────────────────────────────────────────── */

    .hero-ctas {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        opacity: 0;
        animation: fade-up 0.5s ease-out 0.82s both;
    }

    .cta-primary,
    .cta-secondary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.75rem;
        font-family: var(--font-sans);
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-decoration: none;
        border-radius: 0;
        transition: all 0.2s ease;
        cursor: pointer;
        white-space: nowrap;
    }

    .cta-primary {
        background: var(--color-accent);
        color: #fff;
        border: 1px solid var(--color-accent);
    }

    .cta-primary:hover {
        background: color-mix(in srgb, var(--color-accent) 85%, white);
        border-color: color-mix(in srgb, var(--color-accent) 85%, white);
    }

    .cta-primary:hover .cta-arrow {
        transform: translateX(4px);
    }

    .cta-arrow {
        transition: transform 0.2s ease;
        display: inline-block;
    }

    .cta-secondary {
        background: transparent;
        color: var(--color-text-secondary);
        border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
    }

    .cta-secondary:hover {
        color: var(--color-text-primary);
        border-color: var(--color-accent);
        background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    }

    /* ─── Scroll Hint ─────────────────────────────────────────── */

    .scroll-hint {
        position: absolute;
        bottom: 2.5rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        opacity: 0;
        animation: fade-up 0.5s ease-out 1.2s both;
    }

    .scroll-label {
        font-family: var(--font-mono);
        font-size: 0.625rem;
        letter-spacing: 0.25em;
        color: var(--color-text-secondary);
        opacity: 0.5;
        text-transform: uppercase;
        writing-mode: horizontal-tb;
    }

    .scroll-line {
        width: 1px;
        height: 2.5rem;
        background: linear-gradient(
            to bottom,
            var(--color-accent),
            transparent
        );
        opacity: 0.5;
        animation: scroll-bounce 1.6s ease-in-out infinite;
    }

    /* ─── Keyframes ───────────────────────────────────────────── */

    @keyframes name-reveal {
        from {
            clip-path: inset(0 100% 0 0);
            opacity: 0.4;
        }
        to {
            clip-path: inset(0 0% 0 0);
            opacity: 1;
        }
    }

    @keyframes fade-up {
        from {
            opacity: 0;
            transform: translateY(16px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes cursor-blink {
        0%, 49% { opacity: 1; }
        50%, 100% { opacity: 0; }
    }

    @keyframes scroll-bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(6px); }
    }

    /* ─── Reduced Motion ──────────────────────────────────────── */

    @media (prefers-reduced-motion: reduce) {
        .name-clip,
        .hero-eyebrow,
        .hero-tagline,
        .hero-ctas,
        .scroll-hint {
            animation: none;
            opacity: 1;
            clip-path: none;
            transform: none;
        }

        .cursor {
            animation: none;
        }

        .scroll-line {
            animation: none;
        }
    }

    /* ─── Responsive ──────────────────────────────────────────── */

    @media (max-width: 640px) {
        .hero-ctas {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.75rem;
        }

        .cta-primary,
        .cta-secondary {
            width: 100%;
            justify-content: center;
        }

        .scroll-hint {
            display: none;
        }
    }
</style>
