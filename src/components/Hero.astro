---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="hero" class="hero">
    <div class="hero-content">
        <p class="hero-kicker">
            <span class="hero-seal" aria-hidden="true">⊙</span>
            Bottega Cianni
        </p>

        <h1 class="hero-headline">{t('hero.valueProp')}</h1>

        <p class="hero-subtitle">{t('hero.subtitle')}</p>

        <div class="hero-ctas">
            <a href="#contatto" class="cta-primary">{t('hero.ctaPrimary')}</a>
            <a href="#commissioni" class="cta-secondary">{t('hero.ctaSecondary')}</a>
        </div>
    </div>
</section>

<style>
    /* ─── Layout ──────────────────────────────────────────────── */

    .hero {
        position: relative;
        min-height: 90svh;
        display: flex;
        align-items: center;
    }

    .hero-content {
        width: 100%;
        max-width: 42rem;
        padding-top: 6rem;
        padding-bottom: 4rem;
        padding-inline: clamp(1.5rem, 8vw, 6rem);
    }

    /* ─── Kicker ──────────────────────────────────────────────── */

    .hero-kicker {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-display);
        font-size: 0.9375rem;
        letter-spacing: 0.04em;
        color: var(--color-ink-soft);
        margin-bottom: 1.5rem;
        opacity: 0;
        animation: fade-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
    }

    .hero-seal {
        color: var(--color-seal);
        font-size: 1.125rem;
    }

    /* ─── Headline ────────────────────────────────────────────── */

    .hero-headline {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        line-height: 1.1;
        margin-bottom: 1.5rem;
        opacity: 0;
        animation: fade-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
    }

    /* ─── Subtitle ────────────────────────────────────────────── */

    .hero-subtitle {
        font-family: var(--font-body);
        font-size: clamp(1rem, 1.5vw, 1.125rem);
        color: var(--color-ink-soft);
        max-width: 60ch;
        margin-bottom: 2.5rem;
        opacity: 0;
        animation: fade-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
    }

    /* ─── CTAs ────────────────────────────────────────────────── */

    .hero-ctas {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        opacity: 0;
        animation: fade-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.55s both;
    }

    .cta-primary,
    .cta-secondary {
        display: inline-flex;
        align-items: center;
        padding: 0.875rem 2rem;
        font-family: var(--font-body);
        font-size: 0.9375rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        text-decoration: none;
        border-radius: 0;
        transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
        white-space: nowrap;
    }

    .cta-primary {
        background: var(--color-accent);
        color: var(--color-paper);
        border: 1px solid var(--color-accent);
    }

    .cta-primary:hover {
        background: color-mix(in srgb, var(--color-accent) 85%, black);
        border-color: color-mix(in srgb, var(--color-accent) 85%, black);
    }

    .cta-secondary {
        background: transparent;
        color: var(--color-ink);
        border: 1px solid var(--color-line);
    }

    .cta-secondary:hover {
        border-color: var(--color-accent);
        background: color-mix(in srgb, var(--color-accent) 6%, transparent);
    }

    /* ─── Keyframes ───────────────────────────────────────────── */

    @keyframes fade-up {
        from {
            opacity: 0;
            transform: translateY(16px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ─── Reduced Motion ──────────────────────────────────────── */

    @media (prefers-reduced-motion: reduce) {
        .hero-kicker,
        .hero-headline,
        .hero-subtitle,
        .hero-ctas {
            animation: none;
            opacity: 1;
            transform: none;
        }
    }

    /* ─── Responsive ──────────────────────────────────────────── */

    @media (max-width: 640px) {
        .hero-ctas {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.75rem;
        }

        .cta-primary,
        .cta-secondary {
            width: 100%;
            justify-content: center;
        }
    }
</style>
