---
import profile from '../data/profile.json';
---

<section id="about" class="about" aria-label="About me">
    <!-- Background layers -->
    <div class="about-bg-grid" aria-hidden="true"></div>
    <div class="about-bg-glow" aria-hidden="true"></div>

    <div class="about-container">

        <!-- Section label -->
        <p class="about-eyebrow about-reveal" aria-hidden="true">// 01 — about.me</p>

        <div class="about-grid">

            <!-- Left: heading + bio -->
            <div class="about-left">
                <h2 class="about-heading about-reveal about-reveal--delay-1">
                    <span class="heading-main">About</span>
                    <span class="heading-accent" aria-hidden="true">/</span>
                </h2>

                <div class="about-bio-card about-reveal about-reveal--delay-2">
                    <p class="about-bio">{profile.bio}</p>
                </div>

                <div class="about-meta about-reveal about-reveal--delay-3">
                    <span class="meta-item">
                        <span class="meta-dot" aria-hidden="true"></span>
                        Available for opportunities
                    </span>
                    <span class="meta-divider" aria-hidden="true">·</span>
                    <span class="meta-item">Based in Italy</span>
                </div>
            </div>

            <!-- Right: terminal card -->
            <div class="about-right about-reveal about-reveal--delay-4" aria-hidden="true">
                <div class="term-card">
                    <div class="term-header">
                        <span class="term-dot term-dot--red"></span>
                        <span class="term-dot term-dot--yellow"></span>
                        <span class="term-dot term-dot--green"></span>
                        <span class="term-title">developer.ts</span>
                    </div>
                    <pre class="term-body"><code><span class="kw">const</span> <span class="var">developer</span> <span class="op">=</span> <span class="brace">&#123;</span>
  <span class="key">name</span><span class="op">:</span>     <span class="str">"Michele Cianni"</span><span class="punct">,</span>
  <span class="key">role</span><span class="op">:</span>     <span class="str">"Full-Stack &amp; AI"</span><span class="punct">,</span>
  <span class="key">focus</span><span class="op">:</span>    <span class="bracket">[</span>
    <span class="str">"Backend"</span><span class="punct">,</span>
    <span class="str">"AI/ML"</span><span class="punct">,</span>
  <span class="bracket">]</span><span class="punct">,</span>
  <span class="key">status</span><span class="op">:</span>   <span class="str">"open to work"</span><span class="punct">,</span>
  <span class="key">learning</span><span class="op">:</span> <span class="str">"ML Engineering"</span><span class="punct">,</span>
<span class="brace">&#125;</span><span class="punct">;</span></code></pre>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    /* ─── Layout ──────────────────────────────────────────────── */

    .about {
        position: relative;
        padding-block: clamp(5rem, 12vw, 9rem);
        overflow: hidden;
    }

    .about-container {
        position: relative;
        z-index: 1;
        width: 100%;
        padding-inline: clamp(1.5rem, 8vw, 6rem);
        max-width: 90rem;
        margin: 0 auto;
    }

    /* ─── Background Layers ───────────────────────────────────── */

    .about-bg-grid {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(
            circle,
            color-mix(in srgb, #6C63FF 18%, transparent) 1px,
            transparent 1px
        );
        background-size: 32px 32px;
        mask-image: radial-gradient(ellipse 70% 80% at 85% 20%, black 20%, transparent 75%);
        opacity: 0.2;
        pointer-events: none;
    }

    .about-bg-glow {
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse 55% 45% at 85% 15%,
            color-mix(in srgb, #6C63FF 10%, transparent),
            transparent 70%
        );
        pointer-events: none;
    }

    /* ─── Eyebrow ─────────────────────────────────────────────── */

    .about-eyebrow {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        color: var(--color-accent);
        margin-bottom: 2.5rem;
    }

    /* ─── Two-column grid ─────────────────────────────────────── */

    .about-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3rem;
        align-items: start;
    }

    @media (min-width: 768px) {
        .about-grid {
            grid-template-columns: 1fr 1fr;
            gap: clamp(2rem, 6vw, 5rem);
            align-items: center;
        }
    }

    /* ─── Left column ─────────────────────────────────────────── */

    .about-left {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }

    .about-heading {
        font-size: clamp(3rem, 8vw, 5.5rem);
        line-height: 1;
        letter-spacing: -0.03em;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0;
        display: flex;
        align-items: baseline;
        gap: 0.2em;
    }

    .heading-main {
        font-family: var(--font-sans);
    }

    .heading-accent {
        font-family: var(--font-mono);
        font-size: 0.65em;
        color: var(--color-accent);
        font-weight: 400;
        opacity: 0.8;
    }

    .about-bio-card {
        background: color-mix(in srgb, var(--color-surface) 60%, transparent);
        border: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        padding: 1.75rem;
        position: relative;
    }

    /* left accent bar */
    .about-bio-card::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(
            to bottom,
            var(--color-accent),
            color-mix(in srgb, var(--color-accent) 20%, transparent)
        );
    }

    .about-bio {
        font-family: var(--font-sans);
        font-size: clamp(0.9rem, 1.8vw, 1.05rem);
        line-height: 1.8;
        color: var(--color-text-secondary);
        margin: 0;
    }

    .about-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .meta-item {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        color: var(--color-text-secondary);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .meta-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #4ade80;
        box-shadow: 0 0 6px #4ade80;
        flex-shrink: 0;
        animation: pulse-dot 2.4s ease-in-out infinite;
    }

    .meta-divider {
        color: color-mix(in srgb, var(--color-text-secondary) 40%, transparent);
        font-size: 0.875rem;
    }

    /* ─── Right column — terminal card ───────────────────────── */

    .about-right {
        display: flex;
        justify-content: center;
    }

    @media (min-width: 768px) {
        .about-right {
            justify-content: flex-end;
        }
    }

    .term-card {
        width: 100%;
        max-width: 22rem;
        background: color-mix(in srgb, var(--color-surface) 80%, transparent);
        border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        overflow: hidden;
        box-shadow:
            0 0 0 1px color-mix(in srgb, var(--color-accent) 8%, transparent),
            0 24px 48px color-mix(in srgb, #000 50%, transparent),
            inset 0 1px 0 color-mix(in srgb, white 4%, transparent);
    }

    .term-header {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.65rem 0.875rem;
        background: color-mix(in srgb, var(--color-surface) 90%, transparent);
        border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 15%, transparent);
    }

    .term-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .term-dot--red    { background: #ff5f57; }
    .term-dot--yellow { background: #febc2e; }
    .term-dot--green  { background: #28c840; }

    .term-title {
        margin-left: auto;
        font-family: var(--font-mono);
        font-size: 0.65rem;
        color: var(--color-text-secondary);
        letter-spacing: 0.05em;
        opacity: 0.6;
    }

    .term-body {
        margin: 0;
        padding: 1.25rem 1.25rem 1.5rem;
        font-family: var(--font-mono);
        font-size: clamp(0.72rem, 1.4vw, 0.82rem);
        line-height: 1.8;
        overflow-x: auto;
    }

    .term-body code {
        display: block;
        white-space: pre;
    }

    /* syntax highlight */
    .kw     { color: #c792ea; }   /* keyword */
    .var    { color: #82aaff; }   /* variable name */
    .op     { color: var(--color-text-secondary); }
    .brace  { color: var(--color-text-secondary); }
    .bracket{ color: var(--color-text-secondary); }
    .key    { color: #f07178; }   /* object key */
    .str    { color: #c3e88d; }   /* string */
    .punct  { color: var(--color-text-secondary); }

    /* ─── Scroll-reveal ───────────────────────────────────────── */

    .about-reveal {
        opacity: 0;
        transform: translateY(20px);
        transition:
            opacity 0.6s ease-out,
            transform 0.6s ease-out;
    }

    .about-reveal.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .about-reveal--delay-1 { transition-delay: 0.1s; }
    .about-reveal--delay-2 { transition-delay: 0.2s; }
    .about-reveal--delay-3 { transition-delay: 0.3s; }
    .about-reveal--delay-4 { transition-delay: 0.42s; }

    /* ─── Keyframes ───────────────────────────────────────────── */

    @keyframes pulse-dot {
        0%, 100% { opacity: 1; box-shadow: 0 0 6px #4ade80; }
        50%       { opacity: 0.6; box-shadow: 0 0 2px #4ade80; }
    }

    /* ─── Reduced Motion ──────────────────────────────────────── */

    @media (prefers-reduced-motion: reduce) {
        .about-reveal {
            opacity: 1;
            transform: none;
            transition: none;
        }

        .meta-dot {
            animation: none;
        }
    }
</style>

<script>
    const reveals = document.querySelectorAll('.about-reveal');

    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    observer.unobserve(entry.target);
                }
            });
        },
        { threshold: 0.15 }
    );

    reveals.forEach((el) => observer.observe(el));
</script>
