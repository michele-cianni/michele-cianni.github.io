---
const navLinks = [
    { label: 'About',    href: '#about',    index: '01' },
    { label: 'Skills',   href: '#skills',   index: '02' },
    { label: 'Projects', href: '#projects', index: '03' },
    { label: 'Contact',  href: '#contact',  index: '04' },
];
---

<!-- Scroll progress line — fixed at the very top of the viewport -->
<div id="scroll-bar" aria-hidden="true"></div>

<header id="navbar">
    <nav>
        <!-- Logo: terminal-prompt style -->
        <a href="#hero" class="logo" aria-label="Michele Cianni — home">
            <span class="logo-bracket">[</span>
            <span class="logo-initials">MC</span>
            <span class="logo-bracket">]</span>
            <span class="logo-cursor" aria-hidden="true">_</span>
        </a>

        <!-- Desktop nav: indexed items -->
        <ul class="nav-list" role="list">
            {navLinks.map(({ label, href, index }) => (
                <li>
                    <a href={href} class="nav-item">
                        <span class="nav-index">{index}</span>
                        <span class="nav-sep">/</span>
                        <span class="nav-label">{label}</span>
                    </a>
                </li>
            ))}
        </ul>

        <!-- Mobile toggle button -->
        <button
            id="menu-btn"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="mobile-overlay"
        >
            <span id="btn-label-open">MENU</span>
            <span id="btn-label-close" class="btn-label-hidden">CLOSE</span>
        </button>
    </nav>

    <!-- Bottom shimmer line -->
    <div class="shimmer-line" aria-hidden="true"></div>
</header>

<!-- Full-screen mobile overlay -->
<div id="mobile-overlay" hidden aria-label="Navigation menu">
    <!-- Decorative index mark -->
    <span class="overlay-mark" aria-hidden="true">// nav</span>

    <nav class="overlay-nav" aria-label="Mobile navigation">
        {navLinks.map(({ label, href, index }) => (
            <a href={href} class="overlay-link" data-index={index}>
                <span class="overlay-index" aria-hidden="true">{index}</span>
                <span class="overlay-label">{label}</span>
                <span class="overlay-arrow" aria-hidden="true">→</span>
            </a>
        ))}
    </nav>

    <footer class="overlay-footer">
        <span>Michele Cianni</span>
        <span class="overlay-footer-role">Full-Stack Developer &amp; AI Enthusiast</span>
    </footer>
</div>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap');

    /* ── Scroll progress ───────────────────────────── */

    #scroll-bar {
        position: fixed;
        top: 0;
        left: 0;
        height: 2px;
        width: 0%;
        background: linear-gradient(90deg, var(--color-accent), #a78bfa);
        z-index: 200;
        transition: width 80ms linear;
        pointer-events: none;
    }

    /* ── Header ────────────────────────────────────── */

    header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        transition: background-color 0.4s ease, backdrop-filter 0.4s ease;
    }

    header.is-scrolled {
        background-color: color-mix(in srgb, var(--color-background) 88%, transparent);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }

    nav {
        max-width: 72rem;
        margin: 0 auto;
        padding: 0 1.5rem;
        height: 4rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* ── Logo ──────────────────────────────────────── */

    .logo {
        display: inline-flex;
        align-items: baseline;
        gap: 0.05em;
        text-decoration: none;
        color: var(--color-text-primary);
        transition: color 0.2s ease;
        /* Prevent global a:hover opacity from applying */
    }

    .logo:hover {
        opacity: 1;
        color: var(--color-text-primary);
    }

    .logo-bracket {
        font-family: var(--font-mono);
        font-size: 1.625rem;
        color: var(--color-accent);
        line-height: 1;
    }

    .logo-initials {
        font-family: 'Bebas Neue', cursive;
        font-size: 1.625rem;
        letter-spacing: 0.06em;
        line-height: 1;
        transition: color 0.2s ease;
    }

    .logo:hover .logo-initials {
        color: var(--color-accent);
    }

    .logo-cursor {
        font-family: var(--font-mono);
        font-size: 1rem;
        color: var(--color-accent);
        margin-left: 0.05em;
        animation: blink 1.1s step-end infinite;
    }

    @keyframes blink {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0; }
    }

    /* ── Desktop nav list ──────────────────────────── */

    .nav-list {
        display: none;
        align-items: center;
        gap: 2.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    @media (min-width: 768px) {
        .nav-list { display: flex; }
    }

    .nav-item {
        display: inline-flex;
        align-items: baseline;
        gap: 0.35em;
        text-decoration: none;
        transition: opacity 0.2s ease;
    }

    .nav-item:hover {
        opacity: 1;
    }

    .nav-index {
        font-family: var(--font-mono);
        font-size: 0.625rem;
        font-weight: 500;
        color: var(--color-accent);
        opacity: 0.55;
        letter-spacing: 0.05em;
        transition: opacity 0.2s ease;
    }

    .nav-sep {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        color: var(--color-text-secondary);
        opacity: 0.3;
    }

    .nav-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--color-text-secondary);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        transition: color 0.2s ease;
        position: relative;
        padding-bottom: 2px;
    }

    /* Underline slide-in on hover */
    .nav-label::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 1px;
        background-color: var(--color-accent);
        transition: width 0.25s ease;
    }

    .nav-item:hover .nav-label {
        color: var(--color-text-primary);
    }

    .nav-item:hover .nav-index {
        opacity: 1;
    }

    .nav-item:hover .nav-label::after {
        width: 100%;
    }

    /* ── Shimmer line ──────────────────────────────── */

    .shimmer-line {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent 0%,
            color-mix(in srgb, var(--color-accent) 20%, transparent) 20%,
            color-mix(in srgb, var(--color-accent) 55%, transparent) 50%,
            color-mix(in srgb, var(--color-accent) 20%, transparent) 80%,
            transparent 100%
        );
        background-size: 200% 100%;
        animation: shimmer 5s ease-in-out infinite;
    }

    @keyframes shimmer {
        0%   { background-position: 200% center; }
        100% { background-position: -200% center; }
    }

    /* ── Mobile menu button ────────────────────────── */

    #menu-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
        padding: 0.375rem 0.875rem;
        cursor: pointer;
        transition: border-color 0.2s ease, background-color 0.2s ease;
    }

    #menu-btn:hover {
        border-color: var(--color-accent);
        background-color: color-mix(in srgb, var(--color-accent) 8%, transparent);
    }

    #menu-btn span {
        font-family: var(--font-mono);
        font-size: 0.625rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        color: var(--color-accent);
    }

    .btn-label-hidden {
        display: none;
    }

    @media (min-width: 768px) {
        #menu-btn { display: none; }
    }

    /* ── Mobile full-screen overlay ────────────────── */

    #mobile-overlay {
        position: fixed;
        inset: 0;
        z-index: 90;
        background-color: var(--color-background);
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        padding: 6rem 2rem 3rem;
        opacity: 0;
        transform: translateY(-12px);
        transition: opacity 0.3s ease, transform 0.3s ease;
        pointer-events: none;
        overflow-y: auto;
    }

    /* When hidden attribute is removed but before .is-open, keep invisible */
    #mobile-overlay:not(.is-open) {
        pointer-events: none;
    }

    #mobile-overlay.is-open {
        opacity: 1;
        transform: translateY(0);
        pointer-events: all;
    }

    .overlay-mark {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        color: var(--color-accent);
        opacity: 0.45;
        letter-spacing: 0.1em;
        margin-bottom: 2.5rem;
    }

    /* Parent grid defines shared column tracks for all rows */
    .overlay-nav {
        display: grid;
        grid-template-columns: 2.5rem 1fr 1.5rem;
        column-gap: 0.75rem;
        border-top: 1px solid color-mix(in srgb, var(--color-text-secondary) 12%, transparent);
    }

    /* Each link spans all columns and adopts the parent's tracks via subgrid */
    .overlay-link {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: subgrid;
        align-items: center;
        text-decoration: none;
        padding: 1.125rem 0;
        border-bottom: 1px solid color-mix(in srgb, var(--color-text-secondary) 12%, transparent);
    }

    .overlay-link:hover .overlay-label {
        color: var(--color-accent);
    }

    .overlay-link:hover .overlay-arrow {
        opacity: 1;
        transform: translateX(4px);
    }

    .overlay-index {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        color: var(--color-accent);
        opacity: 0.6;
    }

    .overlay-label {
        font-family: 'Bebas Neue', cursive;
        font-size: 2.75rem;
        color: var(--color-text-primary);
        letter-spacing: 0.04em;
        line-height: 1;
        transition: color 0.2s ease;
    }

    .overlay-arrow {
        font-family: var(--font-mono);
        font-size: 1.125rem;
        color: var(--color-accent);
        opacity: 0;
        text-align: right;
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    @media (min-width: 768px) {
        #mobile-overlay { display: none !important; }
    }

    .overlay-footer {
        margin-top: auto;
        padding-top: 2rem;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .overlay-footer span:first-child {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        color: var(--color-text-secondary);
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .overlay-footer-role {
        font-family: var(--font-mono);
        font-size: 0.625rem;
        color: var(--color-accent);
        opacity: 0.5;
        letter-spacing: 0.08em;
    }
</style>

<script>
    /* ── Scroll: progress bar + header background ── */
    const scrollBar = document.getElementById('scroll-bar') as HTMLElement;
    const navbar    = document.getElementById('navbar') as HTMLElement;

    window.addEventListener('scroll', () => {
        const scrolled = window.scrollY;
        const total    = document.documentElement.scrollHeight - window.innerHeight;
        scrollBar.style.width = total > 0 ? `${(scrolled / total) * 100}%` : '0%';
        navbar.classList.toggle('is-scrolled', scrolled > 24);
    }, { passive: true });

    /* ── Mobile overlay toggle ─────────────────── */
    const btn          = document.getElementById('menu-btn') as HTMLButtonElement;
    const overlay      = document.getElementById('mobile-overlay') as HTMLElement;
    const labelOpen    = document.getElementById('btn-label-open') as HTMLElement;
    const labelClose   = document.getElementById('btn-label-close') as HTMLElement;

    function openMenu() {
        overlay.hidden = false;
        overlay.offsetHeight; // force reflow so CSS transition fires
        overlay.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
        btn.setAttribute('aria-label', 'Close navigation menu');
        labelOpen.classList.add('btn-label-hidden');
        labelClose.classList.remove('btn-label-hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
        overlay.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Open navigation menu');
        labelOpen.classList.remove('btn-label-hidden');
        labelClose.classList.add('btn-label-hidden');
        document.body.style.overflow = '';
        overlay.addEventListener('transitionend', () => {
            overlay.hidden = true;
        }, { once: true });
    }

    btn.addEventListener('click', () => {
        overlay.classList.contains('is-open') ? closeMenu() : openMenu();
    });

    overlay.querySelectorAll('a').forEach(link =>
        link.addEventListener('click', closeMenu)
    );

    // Auto-close if viewport is resized to desktop width
    const mq = window.matchMedia('(min-width: 768px)');
    mq.addEventListener('change', (e) => {
        if (e.matches) closeMenu();
    });
</script>
