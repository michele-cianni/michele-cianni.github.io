---
import profile from '../data/profile.json';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLinks = [
    { key: 'nav.about',    href: '#about' },
    { key: 'nav.services', href: '#skills' },
    { key: 'nav.work',     href: '#commissioni' },
    { key: 'nav.contact',  href: '#contact' },
    { key: 'nav.cv',       href: profile.cvUrl, external: true },
];

// Single-page site: every locale's index lives at its own root, so the
// locale-agnostic path is always empty — still derived from the URL (not
// hardcoded) so this keeps working if more pages are added later.
const localePath = Astro.url.pathname.replace(/^\/en\/?/, '').replace(/^\//, '');
const otherLang = lang === 'it' ? 'en' : 'it';
const toggleHref = getRelativeLocaleUrl(otherLang, localePath);
const toggleLabel = otherLang.toUpperCase();
const toggleAriaLabel = lang === 'it' ? 'Switch to English' : "Passa all'italiano";
---

<header id="navbar">
    <nav class="nav-inner">
        <a href="#hero" class="wordmark" aria-label={`${profile.name} — home`}>
            {profile.name}
        </a>

        <ul class="nav-list" role="list">
            {navLinks.map(({ key, href, external }) => (
                <li>
                    <a href={href} class="nav-item" {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                        {t(key)}
                    </a>
                </li>
            ))}
        </ul>

        <div class="nav-actions">
            <a href={toggleHref} class="lang-toggle" aria-label={toggleAriaLabel}>
                {toggleLabel}
            </a>

            <button
                id="menu-btn"
                aria-label={t('nav.menuOpen')}
                aria-expanded="false"
                aria-controls="mobile-overlay"
                data-label-open={t('nav.menuOpen')}
                data-label-close={t('nav.menuClose')}
            >
                <span id="btn-label-open">{t('nav.menuOpen')}</span>
                <span id="btn-label-close" class="btn-label-hidden">{t('nav.menuClose')}</span>
            </button>
        </div>
    </nav>
</header>

<!-- Full-screen mobile overlay -->
<div id="mobile-overlay" hidden aria-label="Navigation menu">
    <nav class="overlay-nav" aria-label="Mobile navigation">
        {navLinks.map(({ key, href, external }) => (
            <a href={href} class="overlay-link" {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                <span class="overlay-label">{t(key)}</span>
                <span class="overlay-arrow" aria-hidden="true">→</span>
            </a>
        ))}

        <a href={toggleHref} class="overlay-link overlay-lang" aria-label={toggleAriaLabel}>
            <span class="overlay-label">{lang === 'it' ? 'English' : 'Italiano'}</span>
            <span class="overlay-arrow" aria-hidden="true">→</span>
        </a>
    </nav>

    <footer class="overlay-footer">
        <span>{profile.name}</span>
        <span class="overlay-footer-role">{profile.tagline}</span>
    </footer>
</div>

<style>
    /* ── Header ────────────────────────────────────── */

    header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        transition: background-color 0.4s ease, border-color 0.4s ease;
        border-bottom: 1px solid transparent;
    }

    header.is-scrolled {
        background-color: color-mix(in srgb, var(--color-paper) 92%, transparent);
        border-bottom-color: var(--color-line);
    }

    .nav-inner {
        max-width: 90rem;
        margin: 0 auto;
        padding-inline: clamp(1.5rem, 8vw, 6rem);
        height: 4.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* ── Wordmark ──────────────────────────────────── */

    .wordmark {
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--color-ink);
        text-decoration: none;
    }

    .wordmark:hover {
        opacity: 1;
        color: var(--color-accent);
    }

    /* ── Desktop nav list ──────────────────────────── */

    .nav-list {
        display: none;
        align-items: center;
        gap: 2rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    @media (min-width: 768px) {
        .nav-list { display: flex; }
    }

    .nav-item {
        font-family: var(--font-body);
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--color-ink-soft);
        text-decoration: none;
        position: relative;
        padding-bottom: 2px;
        transition: color 0.2s ease;
    }

    .nav-item::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 1px;
        background-color: var(--color-accent);
        transition: width 0.25s ease;
    }

    .nav-item:hover {
        opacity: 1;
        color: var(--color-ink);
    }

    .nav-item:hover::after {
        width: 100%;
    }

    /* ── Actions: lang toggle + mobile menu button ─── */

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .lang-toggle {
        font-family: var(--font-body);
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.05em;
        color: var(--color-ink);
        text-decoration: none;
        border: 1px solid var(--color-line);
        border-radius: 0;
        padding: 0.35rem 0.65rem;
        transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
    }

    .lang-toggle:hover {
        opacity: 1;
        border-color: var(--color-accent);
        color: var(--color-accent);
        background-color: color-mix(in srgb, var(--color-accent) 6%, transparent);
    }

    /* ── Mobile menu button ────────────────────────── */

    #menu-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: 1px solid var(--color-line);
        border-radius: 0;
        padding: 0.4rem 0.875rem;
        cursor: pointer;
        transition: border-color 0.2s ease, background-color 0.2s ease;
    }

    #menu-btn:hover {
        border-color: var(--color-accent);
        background-color: color-mix(in srgb, var(--color-accent) 6%, transparent);
    }

    #menu-btn span {
        font-family: var(--font-body);
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-ink);
    }

    .btn-label-hidden {
        display: none;
    }

    @media (min-width: 768px) {
        #menu-btn { display: none; }
    }

    /* ── Mobile full-screen overlay ────────────────── */

    #mobile-overlay {
        position: fixed;
        inset: 0;
        z-index: 90;
        background-color: var(--color-paper);
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        padding: 6rem 2rem 3rem;
        opacity: 0;
        transform: translateY(-12px);
        transition: opacity 0.3s ease, transform 0.3s ease;
        pointer-events: none;
        overflow-y: auto;
    }

    #mobile-overlay:not(.is-open) {
        pointer-events: none;
    }

    #mobile-overlay.is-open {
        opacity: 1;
        transform: translateY(0);
        pointer-events: all;
    }

    .overlay-nav {
        display: flex;
        flex-direction: column;
        border-top: 1px solid var(--color-line);
    }

    .overlay-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-decoration: none;
        padding: 1.125rem 0;
        border-bottom: 1px solid var(--color-line);
    }

    .overlay-lang {
        margin-top: 1rem;
        border-top: 2px solid var(--color-line);
    }

    .overlay-link:hover .overlay-label {
        color: var(--color-accent);
    }

    .overlay-link:hover .overlay-arrow {
        opacity: 1;
        transform: translateX(4px);
    }

    .overlay-label {
        font-family: var(--font-display);
        font-size: clamp(2rem, 7vw, 2.75rem);
        font-weight: 400;
        color: var(--color-ink);
        letter-spacing: -0.01em;
        line-height: 1;
        transition: color 0.2s ease;
    }

    .overlay-arrow {
        font-family: var(--font-body);
        font-size: 1.125rem;
        color: var(--color-accent);
        opacity: 0;
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    @media (min-width: 768px) {
        #mobile-overlay { display: none !important; }
    }

    .overlay-footer {
        margin-top: auto;
        padding-top: 2rem;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .overlay-footer span:first-child {
        font-family: var(--font-body);
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--color-ink-soft);
    }

    .overlay-footer-role {
        font-family: var(--font-body);
        font-size: 0.8125rem;
        color: var(--color-ink-soft);
        letter-spacing: 0.02em;
    }
</style>

<script>
    const navbar = document.getElementById('navbar') as HTMLElement;

    let ticking = false;
    window.addEventListener('scroll', () => {
        if (!ticking) {
            requestAnimationFrame(() => {
                navbar.classList.toggle('is-scrolled', window.scrollY > 24);
                ticking = false;
            });
            ticking = true;
        }
    }, { passive: true });

    /* ── Mobile overlay toggle ─────────────────── */
    const btn          = document.getElementById('menu-btn') as HTMLButtonElement;
    const overlay      = document.getElementById('mobile-overlay') as HTMLElement;
    const labelOpen    = document.getElementById('btn-label-open') as HTMLElement;
    const labelClose   = document.getElementById('btn-label-close') as HTMLElement;
    const ariaOpenLabel  = btn.dataset.labelOpen ?? 'Open navigation menu';
    const ariaCloseLabel = btn.dataset.labelClose ?? 'Close navigation menu';

    function openMenu() {
        overlay.hidden = false;
        overlay.offsetHeight; // force reflow so CSS transition fires
        overlay.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
        btn.setAttribute('aria-label', ariaCloseLabel);
        labelOpen.classList.add('btn-label-hidden');
        labelClose.classList.remove('btn-label-hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
        overlay.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', ariaOpenLabel);
        labelOpen.classList.remove('btn-label-hidden');
        labelClose.classList.add('btn-label-hidden');
        document.body.style.overflow = '';
        overlay.addEventListener('transitionend', () => {
            if (!overlay.classList.contains('is-open')) {
                overlay.hidden = true;
            }
        }, { once: true });
    }

    btn.addEventListener('click', () => {
        overlay.classList.contains('is-open') ? closeMenu() : openMenu();
    });

    overlay.querySelectorAll('a').forEach(link =>
        link.addEventListener('click', closeMenu)
    );

    // Auto-close if viewport is resized to desktop width
    const mq = window.matchMedia('(min-width: 768px)');
    mq.addEventListener('change', (e) => {
        if (e.matches) closeMenu();
    });
</script>
