---
import profile from '../data/profile.json';

const navLinks = [
    { label: 'About',    href: '#about',    index: '01' },
    { label: 'Skills',   href: '#skills',   index: '02' },
    { label: 'Projects', href: '#commissioni', index: '03' },
    { label: 'Contact',  href: '#contact',  index: '04' },
    { label: 'CV',       href: profile.cvUrl, index: '05', external: true },
];

const year = new Date().getFullYear();
---

<footer id="footer" class="reveal">
    <!-- Top shimmer line — visual bookend to the Navbar -->
    <div class="shimmer-line" aria-hidden="true"></div>

    <div class="footer-inner">
        <!-- ── Left: identity ─────────────────────── -->
        <div class="footer-identity">
            <a href="#hero" class="logo" aria-label="Back to top">
                <span class="logo-bracket">[</span>
                <span class="logo-initials">MC</span>
                <span class="logo-bracket">]</span>
                <span class="logo-cursor" aria-hidden="true">_</span>
            </a>
            <p class="copyright">
                <span class="copy-symbol">©</span>{year} Michele Cianni
            </p>
            <p class="tagline-meta">// {profile.tagline}</p>
        </div>

        <!-- ── Centre: nav ──────────────────────── -->
        <nav class="footer-nav" aria-label="Footer navigation">
            {navLinks.map(({ label, href, index, external }) => (
                <a href={href} class="footer-nav-item" {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                    <span class="nav-index">{index}</span>
                    <span class="nav-sep">/</span>
                    <span class="nav-label">{label}</span>
                </a>
            ))}
        </nav>

        <!-- ── Right: social + built-with ────────── -->
        <div class="footer-social">
            <div class="social-links">
                <a
                    href={profile.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-link"
                    aria-label="GitHub profile"
                >
                    <!-- GitHub icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                    </svg>
                </a>
                <a
                    href={profile.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-link"
                    aria-label="LinkedIn profile"
                >
                    <!-- LinkedIn icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                </a>
                <a
                    href={profile.telegram}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-link"
                    aria-label="Telegram profile"
                >
                    <!-- Telegram icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8-1.68 7.92c-.12.56-.44.7-.9.44l-2.5-1.84-1.2 1.16c-.13.13-.25.25-.52.25l.18-2.58 4.7-4.24c.2-.18-.04-.28-.32-.1L7.9 14.16 5.44 13.4c-.55-.17-.56-.55.12-.82l8.87-3.42c.46-.17.86.1.21.64z"/>
                    </svg>
                </a>
                <a
                    href={profile.whatsapp}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-link"
                    aria-label="WhatsApp"
                >
                    <!-- WhatsApp icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                    </svg>
                </a>
                <a
                    href={profile.instagram}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-link"
                    aria-label="Instagram profile"
                >
                    <!-- Instagram icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                    </svg>
                </a>
            </div>

            <span class="built-with" aria-label="Built with Astro">
                // built with&nbsp;<span class="astro-name">Astro</span>
            </span>
        </div>
    </div>

    <!-- Bottom terminal exit strip -->
    <div class="footer-exit" aria-hidden="true">
        <span class="exit-line">process.exit(0)&nbsp;&nbsp;//&nbsp;session closed · {year}</span>
    </div>
</footer>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap');

    /* ── Reveal on scroll ──────────────────────────── */

    .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
                    transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* ── Footer root ───────────────────────────────── */

    footer {
        position: relative;
        background-color: color-mix(in srgb, var(--color-surface) 45%, var(--color-background));
    }

    /* ── Shimmer line — mirrors Navbar ─────────────── */

    .shimmer-line {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent 0%,
            color-mix(in srgb, var(--color-accent) 20%, transparent) 20%,
            color-mix(in srgb, var(--color-accent) 55%, transparent) 50%,
            color-mix(in srgb, var(--color-accent) 20%, transparent) 80%,
            transparent 100%
        );
        background-size: 200% 100%;
        animation: shimmer 5s ease-in-out infinite;
        animation-delay: 2.5s; /* offset from Navbar so they don't pulse in sync */
    }

    @keyframes shimmer {
        0%   { background-position: 200% center; }
        100% { background-position: -200% center; }
    }

    /* ── Inner grid ────────────────────────────────── */

    .footer-inner {
        max-width: 72rem;
        margin: 0 auto;
        padding: 3rem 1.5rem 2.25rem;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
    }

    @media (min-width: 640px) {
        .footer-inner {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (min-width: 1024px) {
        .footer-inner {
            grid-template-columns: 1fr auto 1fr;
            align-items: start;
        }
    }

    /* ── Identity (left) ───────────────────────────── */

    .footer-identity {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .logo {
        display: inline-flex;
        align-items: baseline;
        gap: 0.05em;
        text-decoration: none;
        color: var(--color-text-primary);
        width: fit-content;
    }

    .logo:hover {
        opacity: 1;
    }

    .logo-bracket {
        font-family: var(--font-mono);
        font-size: 1.375rem;
        color: var(--color-accent);
        line-height: 1;
    }

    .logo-initials {
        font-family: 'Bebas Neue', cursive;
        font-size: 1.375rem;
        letter-spacing: 0.06em;
        line-height: 1;
        transition: color 0.2s ease;
    }

    .logo:hover .logo-initials {
        color: var(--color-accent);
    }

    .logo-cursor {
        font-family: var(--font-mono);
        font-size: 0.875rem;
        color: var(--color-accent);
        margin-left: 0.05em;
        animation: blink 1.1s step-end infinite;
        animation-delay: 0.55s; /* offset from Navbar cursor */
    }

    @keyframes blink {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0; }
    }

    .copyright {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        color: var(--color-text-secondary);
        letter-spacing: 0.06em;
        margin: 0;
        display: flex;
        align-items: baseline;
        gap: 0.3em;
    }

    .copy-symbol {
        color: var(--color-accent);
        opacity: 0.7;
    }

    .tagline-meta {
        font-family: var(--font-mono);
        font-size: 0.625rem;
        color: var(--color-accent);
        opacity: 0.4;
        letter-spacing: 0.06em;
        margin: 0;
    }

    /* ── Nav (centre) ──────────────────────────────── */

    .footer-nav {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .footer-nav-item {
        display: inline-flex;
        align-items: baseline;
        gap: 0.35em;
        text-decoration: none;
        width: fit-content;
        transition: opacity 0.2s ease;
    }

    .footer-nav-item:hover {
        opacity: 1;
    }

    .nav-index {
        font-family: var(--font-mono);
        font-size: 0.5625rem;
        font-weight: 500;
        color: var(--color-accent);
        opacity: 0.5;
        letter-spacing: 0.05em;
        transition: opacity 0.2s ease;
    }

    .nav-sep {
        font-family: var(--font-mono);
        font-size: 0.625rem;
        color: var(--color-text-secondary);
        opacity: 0.25;
    }

    .nav-label {
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--color-text-secondary);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        position: relative;
        padding-bottom: 1px;
        transition: color 0.2s ease;
    }

    .nav-label::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 1px;
        background-color: var(--color-accent);
        transition: width 0.25s ease;
    }

    .footer-nav-item:hover .nav-label {
        color: var(--color-text-primary);
    }

    .footer-nav-item:hover .nav-index {
        opacity: 1;
    }

    .footer-nav-item:hover .nav-label::after {
        width: 100%;
    }

    /* ── Social + built-with (right) ───────────────── */

    .footer-social {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    @media (min-width: 1024px) {
        .footer-social {
            align-items: flex-end;
        }
    }

    .social-links {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .social-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.125rem;
        height: 2.125rem;
        border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
        color: var(--color-text-secondary);
        transition: border-color 0.2s ease, color 0.2s ease,
                    background-color 0.2s ease, transform 0.2s ease;
    }

    .social-link:hover {
        opacity: 1;
        border-color: var(--color-accent);
        color: var(--color-accent);
        background-color: color-mix(in srgb, var(--color-accent) 8%, transparent);
        transform: translateY(-2px);
    }

    .social-link svg {
        width: 1rem;
        height: 1rem;
    }

    .built-with {
        font-family: var(--font-mono);
        font-size: 0.6rem;
        color: var(--color-text-secondary);
        opacity: 0.35;
        letter-spacing: 0.06em;
        white-space: nowrap;
    }

    .astro-name {
        color: var(--color-accent);
        opacity: 0.9;
    }

    /* ── Terminal exit strip ───────────────────────── */

    .footer-exit {
        border-top: 1px solid color-mix(in srgb, var(--color-text-secondary) 8%, transparent);
        padding: 0.875rem 1.5rem;
        max-width: 72rem;
        margin: 0 auto;
        width: 100%;
    }

    .exit-line {
        font-family: var(--font-mono);
        font-size: 0.5625rem;
        color: var(--color-text-secondary);
        opacity: 0.2;
        letter-spacing: 0.07em;
    }

    /* ── Reduced motion ────────────────────────────── */

    @media (prefers-reduced-motion: reduce) {
        .shimmer-line { animation: none; }
        .logo-cursor  { animation: none; }
        .reveal       { transition: none; opacity: 1; transform: none; }
    }
</style>

<script>
    const footer = document.getElementById('footer');
    if (footer) {
        const observer = new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting) {
                    footer.classList.add('is-visible');
                    observer.disconnect();
                }
            },
            { threshold: 0.1 }
        );
        observer.observe(footer);
    }
</script>
