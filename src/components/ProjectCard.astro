---
import { useTranslations } from '../i18n/utils';
import type { ui } from '../i18n/ui';

export type LocalizedString = { it: string; en: string };

export interface Project {
    id: string;
    title: string;
    description: string;
    techStack: string[];
    role?: string;
    githubUrl: string | null;
    liveUrl: string | null;
    featured: boolean;
    order: number;
    sector: LocalizedString;
    problem: LocalizedString;
    built: LocalizedString;
    result: LocalizedString;
}

interface Props {
    project: Project;
    index: number;
    lang: keyof typeof ui;
}

const { project, index, lang } = Astro.props;
const t = useTranslations(lang);

function padIndex(i: number): string {
    return String(i + 1).padStart(2, '0');
}

function extractDomain(url: string | null): string {
    if (!url) return '';
    try {
        return new URL(url).hostname.replace(/^www\./, '');
    } catch {
        return url;
    }
}

const displayIndex = padIndex(index);
const domain = extractDomain(project.liveUrl);

const detailRows = [
    { label: t('projects.problemLabel'), value: project.problem[lang] },
    { label: t('projects.builtLabel'), value: project.built[lang] },
    { label: t('projects.resultLabel'), value: project.result[lang] },
];
---

<article
    class="commission commission-reveal"
    style={`transition-delay: ${(0.1 + index * 0.12).toFixed(2)}s`}
    aria-label={project.title}
>
    <div class="commission-top">
        <p class="commission-label">
            {t('projects.itemLabel')} {displayIndex}
            <span class="commission-seal" aria-hidden="true">⊙</span>
        </p>
        <p class="commission-sector">{t('projects.sectorLabel')}: {project.sector[lang]}</p>
    </div>

    <h3 class="commission-title">{project.title}</h3>

    <div class="commission-rule" aria-hidden="true"></div>

    <dl class="commission-details">
        {detailRows.map((row) => (
            <div class="detail-row">
                <dt>{row.label}</dt>
                <dd>→ {row.value}</dd>
            </div>
        ))}
    </dl>

    <div class="commission-footer">
        <p class="commission-tech">tech · {project.techStack.join(', ')}</p>
        {project.liveUrl && (
            <a
                href={project.liveUrl}
                class="commission-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit ${project.title} live site`}
            >
                → {domain}
            </a>
        )}
    </div>
</article>

<style>
    /* ─── Shell ───────────────────────────────────────────────── */

    .commission {
        padding-block: clamp(2rem, 5vw, 3rem);
        border-top: 1px solid var(--color-line);
    }

    .commission:first-child {
        border-top: none;
        padding-top: 0;
    }

    /* ─── Top row ─────────────────────────────────────────────── */

    .commission-top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        flex-wrap: wrap;
        font-family: var(--font-body);
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 0.75rem;
    }

    .commission-label {
        color: var(--color-accent);
        margin: 0;
    }

    .commission-seal {
        color: var(--color-seal);
        margin-left: 0.35em;
    }

    .commission-sector {
        color: var(--color-ink-soft);
        margin: 0;
    }

    /* ─── Title ───────────────────────────────────────────────── */

    .commission-title {
        margin: 0 0 1.5rem;
    }

    /* ─── Divider ─────────────────────────────────────────────── */

    .commission-rule {
        height: 1px;
        background: var(--color-line);
        margin-bottom: 1.5rem;
    }

    /* ─── Details ─────────────────────────────────────────────── */

    .commission-details {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin: 0 0 1.75rem;
    }

    .detail-row {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.25rem;
        max-width: 70ch;
    }

    @media (min-width: 640px) {
        .detail-row {
            grid-template-columns: minmax(140px, 180px) 1fr;
            gap: 1rem;
        }
    }

    .detail-row dt {
        font-family: var(--font-body);
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.05em;
        color: var(--color-ink-soft);
    }

    .detail-row dd {
        font-family: var(--font-body);
        font-size: clamp(0.95rem, 1.6vw, 1.0625rem);
        line-height: 1.7;
        color: var(--color-ink);
        margin: 0;
    }

    /* ─── Footer ──────────────────────────────────────────────── */

    .commission-footer {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .commission-tech {
        font-family: var(--font-body);
        font-size: 0.8125rem;
        color: var(--color-ink-soft);
        margin: 0;
    }

    .commission-link {
        font-family: var(--font-body);
        font-size: 0.9375rem;
        color: var(--color-accent);
    }

    /* ─── Scroll-reveal ───────────────────────────────────────── */

    .commission-reveal {
        opacity: 0;
        transform: translateY(20px);
        transition:
            opacity 0.6s ease-out,
            transform 0.6s ease-out;
    }

    .commission-reveal.visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* ─── Reduced Motion ──────────────────────────────────────── */

    @media (prefers-reduced-motion: reduce) {
        .commission-reveal {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }
</style>
